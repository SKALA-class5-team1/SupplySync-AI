# 이 파일을 프로젝트 루트의 .env로 복사해서 사용합니다.
# 로컬 실행 전용이며 ENV, .env.local, .env.dev, .env.prod는 사용하지 않습니다.

# FastAPI AI 서버 설정 (Spring Boot의 SERVER_PORT와 별개)
HOST=127.0.0.1
PORT=8000
DEBUG=true
RELOAD=true

# CORS 설정: 쉼표로 나열한 문자열이 아닌 JSON 배열로 작성합니다.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# 로깅: 콘솔에만 출력합니다.
LOG_LEVEL=DEBUG

# OpenAI 연동 시 입력합니다. 현재 서버 시작에는 필요하지 않습니다.
OPENAI_API_KEY=

# --- MCP 접속 주소 (/mcp까지 포함). business-mcp 사용법은 MCP_GUIDE.md, rag-mcp는 서버 준비 후 연결 ---
BUSINESS_MCP_URL=http://127.0.0.1:8101/mcp
RAG_MCP_URL=http://127.0.0.1:8102/mcp
RAG_API_DOCS_URL=http://127.0.0.1:8102/docs

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
# 관리 화면 포트. AI 앱의 AMQP 연결에는 사용하지 않습니다.
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=supplysync
RABBITMQ_PASSWORD=changeme

# --- 내부 호출 공용 키 (요청 헤더 X-Internal-Api-Key) ---
# Spring 백엔드 /internal/**와 business-mcp 호출에 모두 씁니다. 두 서버의 INTERNAL_API_KEY와 같은 값이어야 합니다.
INTERNAL_API_KEY=changeme-internal-key

# --- Spring Boot 백엔드 포트 ---
SERVER_PORT=8080

# 선택: JWT 인증 구현 시 설정합니다.
# SECRET_KEY=your-local-secret-key
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=60
